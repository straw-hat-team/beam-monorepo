#!/usr/bin/env python3
#MISE description="Read every published package's owners back from hex.pm and compare them with .config/mise/hex-owners.tsv"
import json
import pathlib
import re
import subprocess
import sys
import urllib.error
import urllib.request

ROOT = pathlib.Path(
    subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True
    ).stdout.strip()
)
TABLE = ROOT / ".config/mise/hex-owners.tsv"
UA = "beam-monorepo-hex-owners-audit (https://github.com/straw-hat-team/beam-monorepo)"


def fetch(url):
    request = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.load(response)


def declared():
    owners = {}
    for line in TABLE.read_text().splitlines():
        if not line or line.startswith("#"):
            continue
        username, level = line.split("\t")
        owners[username] = level
    return owners


def packages():
    for mix in sorted(ROOT.glob("apps/*/mix.exs")):
        match = re.search(r"^\s*@app :(\w+)", mix.read_text(), re.MULTILINE)
        if match is None:
            raise SystemExit(f"error: no @app in {mix.relative_to(ROOT)}")
        yield match.group(1)


def check(package, expected):
    try:
        owners = fetch(f"https://hex.pm/api/packages/{package}/owners")
    except urllib.error.HTTPError as error:
        if error.code == 404:
            return "unpublished", []
        raise
    actual = {owner["username"]: owner["level"] for owner in owners}
    problems = []
    for username, level in expected.items():
        if username not in actual:
            problems.append(f"missing {username} ({level}): mix hex.owner add {package} {username} --level {level}")
        elif actual[username] != level:
            problems.append(f"{username} is {actual[username]}, declared {level}")
    for username, level in actual.items():
        if username not in expected:
            problems.append(f"undeclared owner {username} ({level})")
    return ("ok" if not problems else "MISMATCH"), problems


expected = declared()
failures = 0
for package in packages():
    status, problems = check(package, expected)
    failures += bool(problems)
    print(f"{package}\t{status}")
    for problem in problems:
        print(f"  {problem}")

if failures:
    print(f"\n{failures} package(s) do not match {TABLE.relative_to(ROOT)}.", file=sys.stderr)
    sys.exit(1)
